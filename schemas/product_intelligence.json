{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BFWAI Product Intelligence Handoff Schema (Person 1 to Person 2)",
  "description": "Official schema specification for product_intelligence.csv generated by Person 1 pipeline for Person 2 decision engine.",
  "type": "object",
  "fields": [
    {
      "field_name": "product_id",
      "data_type": "string",
      "description": "Unique identifier for product SKU",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "product_name",
      "data_type": "string",
      "description": "Descriptive title or name of the product",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "category",
      "data_type": "string",
      "description": "Product category grouping",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "brand",
      "data_type": "string",
      "description": "Product brand or manufacturer name",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "forecast_7d",
      "data_type": "integer",
      "description": "Predicted cumulative sales volume in units for the next 7 days",
      "source": "src/customer_forecasting.py (HistGradientBoostingRegressor)",
      "origin_type": "ml-generated"
    },
    {
      "field_name": "forecast_30d",
      "data_type": "integer",
      "description": "Predicted cumulative sales volume in units for the next 30 days",
      "source": "src/customer_forecasting.py (HistGradientBoostingRegressor)",
      "origin_type": "ml-generated"
    },
    {
      "field_name": "sales_trend",
      "data_type": "string",
      "description": "Directional velocity trend of sales ('increasing', 'stable', 'decreasing')",
      "source": "src/customer_forecasting.py",
      "origin_type": "ml-generated"
    },
    {
      "field_name": "current_inventory",
      "data_type": "integer",
      "description": "Current physical stock units on hand in warehouse",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "reserved_inventory",
      "data_type": "integer",
      "description": "Units allocated/reserved for active unfulfilled orders",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "incoming_inventory",
      "data_type": "integer",
      "description": "Units currently in transit or on open purchase orders",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "lead_time_days",
      "data_type": "integer",
      "description": "Supplier lead time in days from order placement to warehouse receipt",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "minimum_order_quantity",
      "data_type": "integer",
      "description": "Supplier minimum order quantity (MOQ) requirement per purchase order batch",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "reorder_point",
      "data_type": "integer",
      "description": "Inventory threshold trigger level for initiating replenishment",
      "source": "customer_inventory_upload.csv",
      "origin_type": "customer-provided"
    },
    {
      "field_name": "market_signal",
      "data_type": "string",
      "description": "External market sentiment signal ('positive', 'neutral', 'negative')",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "market_impact",
      "data_type": "number",
      "description": "Estimated magnitude scale (0.0=negligible to 1.0=very high) of market external event",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "market_confidence",
      "data_type": "number",
      "description": "Confidence score (0.0 to 1.0) of market intelligence analysis",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "market_relevance",
      "data_type": "number",
      "description": "Relevance score (0.0 to 1.0) of retrieved news articles to target product SKU",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "evidence_strength",
      "data_type": "number",
      "description": "Strength score (0.0 to 1.0) of factual news evidence grounding",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "external_signal_available",
      "data_type": "boolean",
      "description": "Flag indicating whether valid external news articles and Gemini signals were retrieved",
      "source": "src/market_intelligence.py",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "market_reason",
      "data_type": "string",
      "description": "Factual analytical rationale summarizing evidence grounding",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "key_events",
      "data_type": "array (JSON string)",
      "description": "List of factual external market events preserving actual publication dates",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "risks",
      "data_type": "array (JSON string)",
      "description": "List of evidence-grounded potential market risk implications",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    },
    {
      "field_name": "opportunities",
      "data_type": "array (JSON string)",
      "description": "List of evidence-grounded potential market opportunity implications",
      "source": "src/market_intelligence.py (Gemini 2.5 Flash API)",
      "origin_type": "externally-generated"
    }
  ]
}
